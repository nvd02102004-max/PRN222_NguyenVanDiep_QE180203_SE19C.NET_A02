@page
@model NguyenVanDiepRazorPages.Pages.Admin.Accounts.IndexModel
@{
    ViewData["Title"] = "Quản lý tài khoản";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-people me-2 text-primary"></i>Quản Lý Tài Khoản (Admin)</h2>
        <span class="text-muted">Quản lý danh sách tài khoản thành viên hệ thống</span>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createAccountModal">
        <i class="bi bi-person-plus me-1"></i>Thêm tài khoản mới
    </button>
</div>

<!-- Search Bar -->
<div class="card card-shadow border-0 mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="Tìm theo tên hoặc email tài khoản..." />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-grow-1">
                    <i class="bi bi-search me-1"></i>Tìm kiếm
                </button>
                @if (!string.IsNullOrEmpty(Model.Search))
                {
                    <a asp-page="/Admin/Accounts/Index" class="btn btn-outline-secondary">Xóa lọc</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Accounts Table -->
<div class="card card-shadow border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Họ và Tên</th>
                        <th>Email</th>
                        <th>Vai trò (Role)</th>
                        <th>Số bài viết</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Accounts == null || !Model.Accounts.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>Không tìm thấy tài khoản nào.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var acc in Model.Accounts)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted">#@acc.AccountId</td>
                                <td class="fw-semibold">@acc.AccountName</td>
                                <td>@acc.AccountEmail</td>
                                <td>
                                    @if (acc.AccountRole == 1)
                                    {
                                        <span class="badge bg-primary px-3 py-2"><i class="bi bi-pencil-square me-1"></i>Staff</span>
                                    }
                                    else if (acc.AccountRole == 2)
                                    {
                                        <span class="badge bg-success px-3 py-2"><i class="bi bi-mortarboard me-1"></i>Lecturer</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary px-3 py-2">Khác (@acc.AccountRole)</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(acc.NewsArticles?.Count ?? 0) bài
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="openEditAccountModal(@acc.AccountId)">
                                        <i class="bi bi-pencil-square me-1"></i>Sửa
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDeleteAccount(@acc.AccountId, '@acc.AccountName')">
                                        <i class="bi bi-trash me-1"></i>Xóa
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Create Account -->
<div class="modal fade" id="createAccountModal" tabindex="-1" aria-labelledby="createAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="createAccountModalLabel">
                        <i class="bi bi-person-plus me-2"></i>Thêm tài khoản mới
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                        <input type="text" name="AccountName" class="form-control" required maxlength="100" placeholder="Ví dụ: Nguyễn Văn A" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                        <input type="email" name="AccountEmail" class="form-control" required maxlength="70" placeholder="email@FUNewsManagement.org" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Vai trò (Role) <span class="text-danger">*</span></label>
                        <select name="AccountRole" class="form-select" required>
                            <option value="1">Staff (Nhân viên quản lý)</option>
                            <option value="2">Lecturer (Giảng viên)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mật khẩu <span class="text-danger">*</span></label>
                        <input type="password" name="AccountPassword" class="form-control" required maxlength="70" placeholder="Nhập mật khẩu cho tài khoản" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu tài khoản</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Edit Account -->
<div class="modal fade" id="editAccountModal" tabindex="-1" aria-labelledby="editAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Edit">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold" id="editAccountModalLabel">
                        <i class="bi bi-pencil-square me-2"></i>Chỉnh sửa tài khoản
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editAccountId" name="AccountId" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">ID Tài khoản</label>
                        <input type="text" id="editAccountIdDisplay" class="form-control bg-light" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                        <input type="text" id="editAccountName" name="AccountName" class="form-control" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                        <input type="email" id="editAccountEmail" name="AccountEmail" class="form-control" required maxlength="70" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Vai trò (Role) <span class="text-danger">*</span></label>
                        <select id="editAccountRole" name="AccountRole" class="form-select" required>
                            <option value="1">Staff (Nhân viên quản lý)</option>
                            <option value="2">Lecturer (Giảng viên)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mật khẩu</label>
                        <input type="password" id="editAccountPassword" name="AccountPassword" class="form-control" maxlength="70" placeholder="Để trống nếu không đổi mật khẩu" />
                        <small class="text-muted">Nhập mật khẩu mới nếu muốn thay đổi.</small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-check-lg me-1"></i>Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Hidden Delete Form -->
<form id="deleteAccountForm" method="post" asp-page-handler="Delete" style="display:none;">
    <input type="hidden" id="deleteAccountId" name="id" />
</form>

@section Scripts {
    <script>
        function openEditAccountModal(accountId) {
            fetch(`?handler=GetAccount&id=${accountId}`)
                .then(response => {
                    if (!response.ok) throw new Error('Không thể tải thông tin tài khoản');
                    return response.json();
                })
                .then(data => {
                    document.getElementById('editAccountId').value = data.accountId;
                    document.getElementById('editAccountIdDisplay').value = '#' + data.accountId;
                    document.getElementById('editAccountName').value = data.accountName || '';
                    document.getElementById('editAccountEmail').value = data.accountEmail || '';
                    document.getElementById('editAccountRole').value = data.accountRole;
                    document.getElementById('editAccountPassword').value = '';
                    
                    var modal = new bootstrap.Modal(document.getElementById('editAccountModal'));
                    modal.show();
                })
                .catch(err => {
                    Swal.fire('Lỗi', err.message, 'error');
                });
        }

        function confirmDeleteAccount(id, name) {
            Swal.fire({
                title: 'Xác nhận xóa tài khoản?',
                text: `Bạn có chắc chắn muốn xóa tài khoản "${name}" (#${id})?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="bi bi-trash me-1"></i>Xóa tài khoản',
                cancelButtonText: 'Hủy bỏ'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteAccountId').value = id;
                    document.getElementById('deleteAccountForm').submit();
                }
            });
        }
    </script>
}
