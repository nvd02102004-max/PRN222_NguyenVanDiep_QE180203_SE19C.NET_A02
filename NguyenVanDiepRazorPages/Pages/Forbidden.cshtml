@page
@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card card-shadow border-0 p-5">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-x display-1"></i>
            </div>
            <h2 class="fw-bold text-danger">403 - Quyền truy cập bị từ chối</h2>
            <p class="text-muted mt-2">Bạn không có quyền thực hiện chức năng này với vai trò hiện tại.</p>
            <div class="mt-4">
                <a asp-page="/News/Index" class="btn btn-primary me-2">
                    <i class="bi bi-house-door me-1"></i>Về trang tin tức
                </a>
                <a asp-page="/Login" class="btn btn-outline-secondary">
                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập tài khoản khác
                </a>
            </div>
        </div>
    </div>
</div>
