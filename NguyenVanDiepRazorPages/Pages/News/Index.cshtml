@page
@model NguyenVanDiepRazorPages.Pages.News.IndexModel
@{
    ViewData["Title"] = "Trang tin tức (SignalR)";
}

<div class="p-4 mb-4 bg-white rounded-3 card-shadow border">
    <div class="row align-items-center">
        <div class="col-md-7">
            <h1 class="display-6 fw-bold text-primary mb-2">
                <i class="bi bi-newspaper me-2"></i>Cổng Thông Tin - Tin Tức FU
            </h1>
            <p class="lead text-muted mb-0">
                Tin tức mới nhất từ hệ thống <span class="badge bg-success-subtle text-success border border-success-subtle ms-1"><i class="bi bi-broadcast me-1"></i>Real-time SignalR</span>
            </p>
        </div>
        <div class="col-md-5">
            <form method="get">
                <div class="input-group">
                    <input type="text" name="Search" value="@Model.Search" class="form-control form-control-lg" placeholder="Tìm kiếm tin tức..." />
                    <button class="btn btn-primary px-4" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Category Filter Pills -->
<div class="mb-4">
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="fw-semibold text-muted me-2"><i class="bi bi-funnel me-1"></i>Danh mục:</span>
        <a asp-page="/News/Index" class="btn btn-sm @(Model.CategoryId == null ? "btn-primary" : "btn-outline-secondary")">
            Tất cả
        </a>
        @foreach (var cat in Model.Categories)
        {
            var isSel = Model.CategoryId == cat.CategoryId;
            <a asp-page="/News/Index" asp-route-categoryId="@cat.CategoryId" asp-route-search="@Model.Search"
               class="btn btn-sm @(isSel ? "btn-primary" : "btn-outline-secondary")">
                @cat.CategoryName
            </a>
        }
    </div>
</div>

<!-- News Grid -->
<div class="row g-4" id="newsContainer">
    @if (Model.Articles == null || !Model.Articles.Any())
    {
        <div class="col-12 text-center py-5">
            <div class="card card-shadow border-0 p-5">
                <i class="bi bi-newspaper display-3 text-muted mb-3"></i>
                <h4 class="text-muted">Không tìm thấy bài viết tin tức nào phù hợp.</h4>
                <div>
                    <a asp-page="/News/Index" class="btn btn-outline-primary mt-2">Xem tất cả tin tức</a>
                </div>
            </div>
        </div>
    }
    else
    {
        @foreach (var item in Model.Articles)
        {
            <div class="col-md-6 col-lg-4" id="article-card-@item.NewsArticleId">
                <div class="card h-100 card-shadow border-0 d-flex flex-column">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                @(item.Category?.CategoryName ?? "Chung")
                            </span>
                            <small class="text-muted">
                                <i class="bi bi-calendar3 me-1"></i>@(item.CreatedDate?.ToString("dd/MM/yyyy") ?? "-")
                            </small>
                        </div>

                        <h5 class="card-title fw-bold mt-2 mb-2">
                            <a asp-page="/News/Details" asp-route-id="@item.NewsArticleId" class="text-decoration-none text-dark hover-primary">
                                @item.NewsTitle
                            </a>
                        </h5>

                        <p class="card-text text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                            @item.Headline
                        </p>

                        <!-- Tags -->
                        @if (item.NewsTags != null && item.NewsTags.Any())
                        {
                            <div class="mb-3 d-flex flex-wrap gap-1">
                                @foreach (var nt in item.NewsTags)
                                {
                                    <span class="badge bg-light text-secondary border small">#@nt.Tag?.TagName</span>
                                }
                            </div>
                        }

                        <div class="pt-3 border-top d-flex justify-content-between align-items-center mt-auto">
                            <small class="text-muted">
                                <i class="bi bi-person me-1"></i>@(item.CreatedBy?.AccountName ?? "FU Editor")
                            </small>
                            <a asp-page="/News/Details" asp-route-id="@item.NewsArticleId" class="btn btn-sm btn-outline-primary">
                                Đọc tiếp <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        // Real-time automatic reload on news updates via SignalR
        window.onNewsDataChanged = function(action, articleId) {
            console.log("SignalR News Event:", action, articleId);
            setTimeout(() => {
                location.reload();
            }, 1000);
        };
    </script>
}
