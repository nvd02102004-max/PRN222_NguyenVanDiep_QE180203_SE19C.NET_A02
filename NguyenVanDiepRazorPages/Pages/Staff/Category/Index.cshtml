@page
@model NguyenVanDiepRazorPages.Pages.Staff.Category.IndexModel
@{
    ViewData["Title"] = "Quản lý danh mục";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-tags me-2 text-primary"></i>Quản Lý Danh Mục (Staff)</h2>
        <span class="text-muted">Quản lý các thể loại bài viết và phân loại tin tức</span>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
        <i class="bi bi-plus-circle me-1"></i>Thêm danh mục mới
    </button>
</div>

<!-- Search Bar -->
<div class="card card-shadow border-0 mb-4">
    <div class="card-body">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="Tìm theo tên hoặc mô tả danh mục..." />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-grow-1">
                    <i class="bi bi-search me-1"></i>Tìm kiếm
                </button>
                @if (!string.IsNullOrEmpty(Model.Search))
                {
                    <a asp-page="/Staff/Category/Index" class="btn btn-outline-secondary">Xóa lọc</a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Categories Table -->
<div class="card card-shadow border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Tên Danh Mục</th>
                        <th>Mô Tả</th>
                        <th>Danh Mục Cha</th>
                        <th>Trạng Thái</th>
                        <th>Số Bài Viết</th>
                        <th class="text-end pe-4">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Categories == null || !Model.Categories.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>Không tìm thấy danh mục nào.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var cat in Model.Categories)
                        {
                            var articleCount = cat.NewsArticles?.Count ?? 0;
                            <tr>
                                <td class="ps-4 fw-bold text-muted">#@cat.CategoryId</td>
                                <td class="fw-semibold text-primary">@cat.CategoryName</td>
                                <td class="text-muted" style="max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    @cat.CategoryDesciption
                                </td>
                                <td>
                                    @(cat.ParentCategory?.CategoryName ?? "-")
                                </td>
                                <td>
                                    @if (cat.IsActive == true)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                            <i class="bi bi-x-circle me-1"></i>Inactive
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @articleCount bài
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <button type="button" class="btn btn-sm btn-outline-primary me-1" onclick="openEditCategoryModal(@cat.CategoryId)">
                                        <i class="bi bi-pencil-square me-1"></i>Sửa
                                    </button>
                                    @if (articleCount > 0)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="alertCannotDelete(@cat.CategoryId, @articleCount)" title="Không thể xóa vì đã có bài viết">
                                            <i class="bi bi-trash me-1"></i>Xóa
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="confirmDeleteCategory(@cat.CategoryId, '@cat.CategoryName')">
                                            <i class="bi bi-trash me-1"></i>Xóa
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Create Category -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-labelledby="createCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold" id="createCategoryModalLabel">
                        <i class="bi bi-plus-circle me-2"></i>Thêm Danh Mục Mới
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên Danh Mục <span class="text-danger">*</span></label>
                        <input type="text" name="CategoryName" class="form-control" required maxlength="100" placeholder="Ví dụ: Công nghệ thông tin" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô Tả <span class="text-danger">*</span></label>
                        <textarea name="CategoryDesciption" class="form-control" rows="3" required maxlength="250" placeholder="Mô tả chi tiết về danh mục"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Danh Mục Cha (Tùy chọn)</label>
                        <select name="ParentCategoryId" class="form-select">
                            <option value="">-- Không có (Danh mục gốc) --</option>
                            @foreach (var c in Model.AllCategories)
                            {
                                <option value="@c.CategoryId">@c.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="createIsActive" checked />
                        <label class="form-check-label fw-semibold" for="createIsActive">Kích hoạt (Active)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu Danh Mục</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Edit Category -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Edit">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold" id="editCategoryModalLabel">
                        <i class="bi bi-pencil-square me-2"></i>Chỉnh Sửa Danh Mục
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editCategoryId" name="CategoryId" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">ID Danh Mục</label>
                        <input type="text" id="editCategoryIdDisplay" class="form-control bg-light" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên Danh Mục <span class="text-danger">*</span></label>
                        <input type="text" id="editCategoryName" name="CategoryName" class="form-control" required maxlength="100" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô Tả <span class="text-danger">*</span></label>
                        <textarea id="editCategoryDesciption" name="CategoryDesciption" class="form-control" rows="3" required maxlength="250"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Danh Mục Cha</label>
                        <select id="editParentCategoryId" name="ParentCategoryId" class="form-select">
                            <option value="">-- Không có (Danh mục gốc) --</option>
                            @foreach (var c in Model.AllCategories)
                            {
                                <option value="@c.CategoryId">@c.CategoryName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3 form-check">
                        <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="editIsActive" />
                        <label class="form-check-label fw-semibold" for="editIsActive">Kích hoạt (Active)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-check-lg me-1"></i>Cập nhật</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Hidden Delete Form -->
<form id="deleteCategoryForm" method="post" asp-page-handler="Delete" style="display:none;">
    <input type="hidden" id="deleteCategoryId" name="id" />
</form>

@section Scripts {
    <script>
        function openEditCategoryModal(id) {
            fetch(`?handler=GetCategory&id=${id}`)
                .then(response => {
                    if (!response.ok) throw new Error('Không thể tải thông tin danh mục');
                    return response.json();
                })
                .then(data => {
                    document.getElementById('editCategoryId').value = data.categoryId;
                    document.getElementById('editCategoryIdDisplay').value = '#' + data.categoryId;
                    document.getElementById('editCategoryName').value = data.categoryName || '';
                    document.getElementById('editCategoryDesciption').value = data.categoryDesciption || '';
                    document.getElementById('editParentCategoryId').value = data.parentCategoryId || '';
                    document.getElementById('editIsActive').checked = data.isActive === true;

                    var modal = new bootstrap.Modal(document.getElementById('editCategoryModal'));
                    modal.show();
                })
                .catch(err => {
                    Swal.fire('Lỗi', err.message, 'error');
                });
        }

        function alertCannotDelete(id, count) {
            Swal.fire({
                title: 'Không thể xóa!',
                text: `Danh mục #${id} hiện đang chứa ${count} bài viết. Theo quy tắc nghiệp vụ, bạn không thể xóa danh mục đã có bài viết tham chiếu.`,
                icon: 'error',
                confirmButtonColor: '#0d6efd'
            });
        }

        function confirmDeleteCategory(id, name) {
            Swal.fire({
                title: 'Xác nhận xóa danh mục?',
                text: `Bạn có chắc chắn muốn xóa danh mục "${name}" (#${id})?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="bi bi-trash me-1"></i>Xóa danh mục',
                cancelButtonText: 'Hủy bỏ'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('deleteCategoryId').value = id;
                    document.getElementById('deleteCategoryForm').submit();
                }
            });
        }
    </script>
}
