@page
@model NguyenVanDiepRazorPages.Pages.Staff.ProfileModel
@{
    ViewData["Title"] = "Hồ sơ cá nhân";
}

<div class="row justify-content-center mt-3">
    <div class="col-md-8 col-lg-7">
        <div class="card card-shadow border-0">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-person-bounding-box me-2"></i>Hồ Sơ Cá Nhân</h4>
                <small class="text-white-50">Cập nhật thông tin tài khoản của bạn</small>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <input type="hidden" asp-for="AccountId" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email tài khoản</label>
                            <input type="text" class="form-control bg-light" value="@Model.AccountEmail" readonly />
                            <small class="text-muted">Email dùng để đăng nhập và không thể thay đổi.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Vai trò (Role)</label>
                            <div>
                                <span class="badge bg-primary px-3 py-2 fs-6">
                                    <i class="bi bi-shield-check me-1"></i>@Model.RoleName
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AccountName" class="form-label fw-semibold">Họ và Tên <span class="text-danger">*</span></label>
                        <input asp-for="AccountName" class="form-control" placeholder="Nhập họ và tên của bạn" />
                        <span asp-validation-for="AccountName" class="text-danger small"></span>
                    </div>

                    <hr class="my-4" />
                    <h5 class="fw-bold mb-3 text-secondary"><i class="bi bi-key me-2"></i>Đổi Mật Khẩu (Tùy chọn)</h5>
                    <p class="text-muted small">Nếu không muốn thay đổi mật khẩu, vui lòng để trống các ô bên dưới.</p>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold">Mật khẩu hiện tại</label>
                        <input asp-for="CurrentPassword" type="password" class="form-control" placeholder="Nhập mật khẩu hiện tại" />
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="NewPassword" class="form-label fw-semibold">Mật khẩu mới</label>
                            <input asp-for="NewPassword" type="password" class="form-control" placeholder="Nhập mật khẩu mới" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu mới</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu mới" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-page="/Staff/NewsArticle/Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Quay lại
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
